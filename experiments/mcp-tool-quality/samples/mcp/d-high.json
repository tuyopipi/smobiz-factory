{
  "name": "complete_strict_format_identity_form",
  "quality": "high",
  "description": "Complete the strict-format identity form. Convert birthdate to YYYY-MM-DD for #birthdate. Fill #visitTime as HH:mm. Use full-width katakana in #kanaFamily and #kanaGiven. Use digits only for #phone, #postalCode, and #annualIncome; remove hyphens, commas, and 円.",
  "input_schema": {
    "type": "object",
    "required": ["birthdate", "visitTime", "kanaFamily", "kanaGiven", "phone", "postalCode", "annualIncome"],
    "properties": {
      "birthdate": {"type": "string", "format": "date", "examples": ["1995-04-01"]},
      "visitTime": {"type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$", "examples": ["14:30"]},
      "kanaFamily": {"type": "string", "description": "Full-width katakana.", "examples": ["ヤマダ"]},
      "kanaGiven": {"type": "string", "description": "Full-width katakana.", "examples": ["タロウ"]},
      "phone": {"type": "string", "pattern": "^[0-9]{10,11}$", "examples": ["09012345678"]},
      "postalCode": {"type": "string", "pattern": "^[0-9]{7}$", "examples": ["1500001"]},
      "annualIncome": {"type": "string", "pattern": "^[0-9]+$", "examples": ["5000000"]}
    }
  }
}
