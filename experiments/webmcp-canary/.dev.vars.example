# Copy to .dev.vars for local wrangler dev only.
# Do not commit .dev.vars with real values.

WEBMCP_REGISTERED_SITE_KEYS=local-wp-demo-key
WEBMCP_ALLOWED_ORIGINS=*
WEBMCP_AB_MIN_SAMPLES=20
WEBMCP_AB_Z_THRESHOLD=1.96
WEBMCP_TRAFFIC_MIN_RESULTS=20
WEBMCP_TRAFFIC_MAX_FAILURE_RATE=0.5
WEBMCP_PRO_PRICE_YEN=3000
WEBMCP_PUBLIC_TAG_URL=http://localhost:8443/tag.js
OPENAI_MODEL=gpt-4.1-mini

# Optional. Set in production with `wrangler secret put WEBMCP_ADMIN_TOKEN`
# to protect /api/site-keys.
# WEBMCP_ADMIN_TOKEN=change-me

# Optional. Only required for /api/repair-insights.
# Set with: wrangler secret put OPENAI_API_KEY

# --- U2 AI Share-of-Voice measurement (pro plan, beta) --------------------
# Entirely opt-in. With no engine key set, SoV endpoints return an explicit
# "unconfigured"/"preparing" state and make no engine calls, so local and
# canary runs work without any secret.
#
# Set these with `wrangler secret put <NAME>` - never put a value in this file,
# in wrangler.jsonc, or anywhere else in the repo. The code only ever reads
# them from the env binding and never logs or returns them.
#   wrangler secret put PERPLEXITY_API_KEY
#   wrangler secret put SOV_OPENAI_API_KEY      # ChatGPT measurement only (optional)
# For a local run, put them in .dev.vars (git-ignored), not in this example file.
# PERPLEXITY_MODEL=sonar
#
# Endpoint overrides. Only honoured for loopback/.test hosts, because the
# request carries the API key; any other value is ignored and the real
# provider is used. Only for pointing a local run at a mock engine.
# PERPLEXITY_API_URL=http://127.0.0.1:8799/chat/completions
# OPENAI_RESPONSES_SOV_API_URL=http://127.0.0.1:8799/v1/responses
#
# ChatGPT measurement. OFF by default, turned on deliberately:
#   1. its own key: wrangler secret put SOV_OPENAI_API_KEY
#      (OPENAI_API_KEY, used by the AEO learning job, is borrowed only with
#      SOV_OPENAI_USE_SHARED_KEY=1, so this measurement cannot spend that
#      job's quota by default)
#   2. a per-site monthly call cap above 0 (default 0 = off), e.g. 120
# SOV_OPENAI_SITE_MONTHLY_CAP=120      # calls per site per month (0 = off, the default)
# SOV_OPENAI_GLOBAL_MONTHLY_CAP=3000   # calls per month, all sites
# SOV_OPENAI_SITE_MONTHLY_USD_CAP=3    # estimated USD per site per month (0 = off)
# SOV_OPENAI_GLOBAL_MONTHLY_USD_CAP=40 # estimated USD per month, all sites
# SOV_OPENAI_MAX_TOOL_CALLS=2          # max_tool_calls per answer (1-10)
# SOV_OPENAI_USE_SHARED_KEY=0
# SOV_OPENAI_MODEL=gpt-6-luna
# SOV_OPENAI_REASONING_EFFORT=low
# SOV_PERPLEXITY_GLOBAL_MONTHLY_CAP=6000  # per-site cap stays 200 (aeo-sov.mjs)
# SOV_PERPLEXITY_SITE_MONTHLY_USD_CAP=5
# SOV_PERPLEXITY_GLOBAL_MONTHLY_USD_CAP=150
#
# Daily batch time budget (ms): no new site after the budget, no new engine
# call after the hard stop (a daily cron may run 15 minutes).
# SOV_BATCH_TIME_BUDGET_MS=600000
# SOV_BATCH_HARD_STOP_MS=780000
# Gemini is not measured: the Gemini API grounding terms forbid analysing
# Grounded Results. GEMINI_API_KEY is ignored by this measurement.
#
# Weekly batch size (pro sites measured per run). Hard caps on questions,
# engines and the per-site monthly query budget live in worker/aeo-sov.mjs.
# SOV_BATCH_LIMIT=50

# --- Billing decides the plan ---------------------------------------------
# A Stripe subscription is what grants standard or pro; the license key only
# links an install to a site. These map a Stripe price to a tier, and a price
# that matches neither grants nothing - an unrecognised price is far likelier
# to be a misconfiguration than a new tier.
#
# Never put a value here. Set them with:
#   wrangler secret put STRIPE_SECRET_KEY
#   wrangler secret put STRIPE_WEBHOOK_SECRET
#   wrangler secret put STRIPE_PRICE_ID_PRO
#   wrangler secret put STRIPE_PRICE_ID_STANDARD
#
# STRIPE_PRICE_ID_STANDARD is new and currently unset, so standard cannot be
# sold through checkout yet; standard sites are provisioned manually until a
# price exists for them. Everything else keeps working with it unset.
#
# For a local test-mode run, put test-mode values in .dev.vars (git-ignored):
# STRIPE_PRICE_ID_PRO=price_...
# STRIPE_PRICE_ID_STANDARD=price_...
