msgid "Tools"
msgstr "Инструменты"

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:4869
msgid "Trend"
msgstr "Динамика"

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:5300
msgid "Try again"
msgstr "Повторить"

