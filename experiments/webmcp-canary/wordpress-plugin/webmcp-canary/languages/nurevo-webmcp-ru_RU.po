msgid "Turn on /llms.txt"
msgstr "Включить /llms.txt"

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:4217
msgid "Turn on in settings"
msgstr "Включить в настройках"

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:6774
msgid "Turn on structured data output"
msgstr "Включить вывод структурированных данных"

#: wordpress-plugin/webmcp-canary/includes/setup-wizard.php:889
msgid "Turns on JSON-LD structured data, /llms.txt, and access for AI search crawlers in robots.txt."
msgstr "Включает структурированные данные JSON-LD, /llms.txt и доступ поисковых ИИ-краулеров в robots.txt."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2085
msgid "Turns on server-side output of the information AI reads."
msgstr "Включает серверный вывод информации, которую читает ИИ."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2136
msgid "URL"
msgstr "URL"

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2636
msgid "Used only when issuing a site key from the Nurevo service."
msgstr "Используется только при выпуске ключа сайта через сервис Nurevo."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:1995
msgid "Valid JSON-LD with the right type and the key properties filled in."
msgstr "Корректный JSON-LD с правильным типом и заполненными ключевыми свойствами."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2151
msgid "Values are inferred from existing local SEO settings, WordPress settings, and clearly labelled public content. Automatic extraction is an estimate; verify before relying on it. Existing Nurevo values are never overwritten."
msgstr "Значения определяются по имеющимся настройкам локального SEO, настройкам WordPress и явно обозначенному публичному содержимому. Автоматическое извлечение — это оценка; проверьте результат, прежде чем на него полагаться. Уже введённые значения Nurevo никогда не перезаписываются."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:4281
msgid "View the updated diagnosis"
msgstr "Посмотреть обновлённую диагностику"

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:5140
msgid "View this site on the nurevo.jp dashboard"
msgstr "Открыть этот сайт в панели управления nurevo.jp"

#: wordpress-plugin/webmcp-canary/includes/setup-wizard.php:345
msgid "Visibility to AI"
msgstr "Видимость для ИИ"

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:4856
msgid "vs previous"
