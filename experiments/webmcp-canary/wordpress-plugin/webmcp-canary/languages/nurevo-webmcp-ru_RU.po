msgstr "Слишком много попыток. Подождите и повторите попытку."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3853
msgid "Trend"
msgstr "Динамика"

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:4257
msgid "Try again"
msgstr "Повторить"

