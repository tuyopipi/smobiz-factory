#: wordpress-plugin/webmcp-canary/includes/setup-wizard.php:606
#: wordpress-plugin/webmcp-canary/includes/setup-wizard.php:611
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2540
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3407
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3457
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3479
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3748
