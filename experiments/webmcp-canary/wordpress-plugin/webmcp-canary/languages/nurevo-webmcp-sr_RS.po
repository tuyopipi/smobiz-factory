msgid "The Nurevo service did not answer within %d seconds. Your server may not be allowed to make outgoing connections, or the service may be busy. Please try again later."
msgstr "Услуга Nurevo није одговорила у року од %d с. Ваш сервер можда нема дозволу за одлазне везе или је услуга заузета. Покушајте поново касније."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2814
msgid "The Nurevo service is not configured."
msgstr "Услуга Nurevo није подешена."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3471
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3739
