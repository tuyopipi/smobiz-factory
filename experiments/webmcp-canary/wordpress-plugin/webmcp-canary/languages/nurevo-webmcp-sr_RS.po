msgstr "Последњих %d мерења, најстарије лево"

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2886
msgid "The license could not be verified. The previously verified plan remains active."
msgstr "Лиценцу није било могуће проверити. Претходно проверени пакет остаје активан."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2822
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2882
msgid "The license key is invalid or inactive."
msgstr "Лиценцни кључ није исправан или није активан."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2835
msgid "The license server is not configured."
msgstr "Лиценцни сервер није подешен."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:1931
msgid "The major AI crawlers are allowed in robots.txt."
msgstr "Главни ВИ краулери су дозвољени у robots.txt."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2808
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2816
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:4337
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:4476
msgid "The Nurevo service could not be reached."
msgstr "Није могуће приступити услузи Nurevo."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3627
