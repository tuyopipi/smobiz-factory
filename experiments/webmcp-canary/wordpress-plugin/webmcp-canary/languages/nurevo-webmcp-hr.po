msgid "The Nurevo service did not answer within %d seconds. Your server may not be allowed to make outgoing connections, or the service may be busy. Please try again later."
msgstr "Usluga Nurevo nije odgovorila unutar %d s. Vaš poslužitelj možda nema dopuštenje za odlazne veze ili je usluga zauzeta. Pokušajte ponovno kasnije."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2750
msgid "The Nurevo service is not configured."
msgstr "Usluga Nurevo nije konfigurirana."

