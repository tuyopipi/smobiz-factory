msgstr "Licencni poslužitelj nije konfiguriran."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:1931
msgid "The major AI crawlers are allowed in robots.txt."
msgstr "Glavni AI indeksirajući botovi dopušteni su u robots.txt."

