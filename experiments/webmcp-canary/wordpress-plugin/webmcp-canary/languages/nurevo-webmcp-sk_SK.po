msgstr "Surové HTML neobsahuje ani váš obsah, ani schema, takže crawlery, ktoré nespúšťajú JavaScript, vidia prázdnu stránku."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:5033
msgid "The service could not diagnose this site. This usually means it is not reachable from the internet yet - a local or password-protected site cannot be read."
msgstr "Služba nemohla tento web diagnostikovať. Zvyčajne to znamená, že zatiaľ nie je dostupný z internetu – lokálny web alebo web chránený heslom sa nedá načítať."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:4738
msgid "The trend appears once a second measurement has run."
msgstr "Vývoj sa zobrazí po druhom meraní."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3484
