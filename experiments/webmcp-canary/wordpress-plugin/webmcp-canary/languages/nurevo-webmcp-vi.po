msgstr "CDN hoặc WAF của bạn đang cho bot AI đi qua."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:1884
msgid "Your content and schema are in the raw HTML."
msgstr "Nội dung và schema của bạn có trong HTML gốc."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:4498
msgid "Your free diagnosis, basic schema, llms.txt and AI crawler access carry on exactly as before."
msgstr "Chẩn đoán miễn phí, schema cơ bản, llms.txt và quyền truy cập của trình thu thập AI vẫn tiếp tục hoạt động như trước."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:1891
msgid "Your JSON-LD is missing some of the properties AI looks for."
msgstr "JSON-LD của bạn thiếu một số thuộc tính mà AI tìm kiếm."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:1903
msgid "Your key facts are hard to find in the page text."
msgstr "Khó tìm thấy các thông tin chính của bạn trong nội dung trang."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:1902
msgid "Your key facts, headings and FAQ are readable in the page text."
msgstr "Các thông tin chính, tiêu đề và FAQ của bạn đều đọc được trong nội dung trang."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:4490
msgid "Your Pro plan is active. Measurement needs a site key and site ID to be configured."
msgstr "Gói Pro của bạn đang hoạt động. Việc đo cần cấu hình khóa trang web và ID trang web."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:1914
