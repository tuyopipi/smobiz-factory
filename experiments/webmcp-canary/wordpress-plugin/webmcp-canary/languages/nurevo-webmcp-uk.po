msgstr "Не вдалося перевірити ліцензію. Залишається активним раніше підтверджений тариф."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2429
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2489
msgid "The license key is invalid or inactive."
msgstr "Ліцензійний ключ недійсний або неактивний."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2442
msgid "The license server is not configured."
msgstr "Сервер ліцензій не налаштовано."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:1538
msgid "The major AI crawlers are allowed in robots.txt."
msgstr "Основні ШІ-краулери дозволені в robots.txt."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2415
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2423
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3656
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3795
msgid "The Nurevo service could not be reached."
msgstr "Не вдалося зв’язатися із сервісом Nurevo."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2357
msgid "The Nurevo service is not configured."
msgstr "Сервіс Nurevo не налаштовано."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:1570
msgid "The page text does not state your key facts, so AI has only your markup to go on."
msgstr "Ключові факти не вказано в тексті сторінки, тому ШІ може спиратися лише на розмітку."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2344
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2413
msgid "The pairing code is invalid or has expired."
msgstr "Код з’єднання недійсний або його термін дії минув."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3654
msgid "The profile sync was rejected by the service."
msgstr "Сервіс відхилив синхронізацію профілю."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:1552
msgid "The raw HTML carries neither your content nor your schema, so crawlers that skip JavaScript see an empty page."
msgstr "У вихідному HTML немає ні вмісту, ні schema, тому краулери, які не виконують JavaScript, бачать порожню сторінку."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:4333
msgid "The service could not diagnose this site. This usually means it is not reachable from the internet yet - a local or password-protected site cannot be read."
msgstr "Сервісу не вдалося виконати діагностику цього сайту. Зазвичай це означає, що сайт ще недоступний з інтернету: локальний або захищений паролем сайт прочитати неможливо."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3053
msgid "The site key is not configured. Open WebMCP > Settings and configure it."
msgstr "Ключ сайту не налаштовано. Відкрийте WebMCP > Налаштування й налаштуйте його."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3153
msgid "The site key is not configured. Open WebMCP > Settings and issue or paste a site key."
msgstr "Ключ сайту не налаштовано. Відкрийте WebMCP > Налаштування й згенеруйте або вставте ключ сайту."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2891
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3057
msgid "The tag.js URL is not configured. Open WebMCP > Settings and configure it."
msgstr "URL tag.js не налаштовано. Відкрийте WebMCP > Налаштування й налаштуйте її."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3150
msgid "The tag.js URL is not configured. Open WebMCP > Settings and enter the public tag.js URL."
msgstr "URL tag.js не налаштовано. Відкрийте WebMCP > Налаштування й введіть публічну URL tag.js."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:4049
msgid "The trend appears once a second measurement has run."
msgstr "Динаміка з’явиться після другого вимірювання."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3160
msgid "The WebMCP server did not respond within %d seconds. The URL may be unreachable from WordPress, the Worker may be slow, or Docker/network egress may be blocked."
msgstr "Сервер WebMCP не відповів протягом %d с. Можливо, URL недоступна з WordPress, Worker працює повільно або вихідний трафік Docker/мережі заблоковано."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3178
msgid "The WebMCP server rejected the site key or admin token: %s"
msgstr "Сервер WebMCP відхилив ключ сайту або токен адміністратора: %s"

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3107
msgid "The WebMCP server response did not match the expected format."
msgstr "Відповідь сервера WebMCP не відповідає очікуваному формату."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2924
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3191
msgid "The WebMCP server returned an error: %s"
msgstr "Сервер WebMCP повернув помилку: %s"

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2917
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3103
msgid "The WebMCP server returned invalid JSON."
msgstr "Сервер WebMCP повернув недійсний JSON."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3029
msgid "There is no site key to disable."
msgstr "Немає ключа сайту для вимкнення."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3007
msgid "There is no site key to regenerate."
msgstr "Немає ключа сайту для перегенерування."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:832
msgid "These collect content to train AI models. They are not needed to appear in AI answers, so this is your choice."
msgstr "Вони збирають контент для навчання ШІ-моделей. Для появи у відповідях ШІ вони не потрібні, тож вирішувати вам."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:814
msgid "These fetch your pages to answer and cite them. Your existing robots.txt rules, such as /wp-admin/, keep applying to them."
msgstr "Вони завантажують ваші сторінки, щоб відповідати на запитання й цитувати їх. Ваші наявні правила robots.txt, наприклад для /wp-admin/, і надалі до них застосовуються."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:4321
msgid "These were inferred from your existing settings and published content. Only blank fields were filled, so please check that the values are right."
msgstr "Ці значення визначено за вашими поточними налаштуваннями та опублікованим вмістом. Заповнено лише порожні поля, тож перевірте правильність значень."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2399
msgid "This code belongs to a site registered as %s. Pair it from that site, or correct the site address on the dashboard."
msgstr "Цей код належить сайту, зареєстрованому як %s. Виконайте з’єднання з того сайту або виправте адресу сайту на панелі керування."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:4081
msgid "This is a beta feature. AI answers vary from run to run, so judge by the trend rather than any single result."
msgstr "Це бета-функція. Відповіді ШІ відрізняються від запуску до запуску, тож орієнтуйтеся на динаміку, а не на окремий результат."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2478
msgid "This license has no seats left. Release another site from the Nurevo dashboard, or use a license with more seats."
msgstr "У цій ліцензії не залишилося вільних місць. Від’єднайте інший сайт на панелі керування Nurevo або скористайтеся ліцензією з більшою кількістю місць."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2481
msgid "This license is not attached to an account yet. Please contact Nurevo support."
msgstr "Цю ліцензію ще не прив’язано до облікового запису. Зверніться до підтримки Nurevo."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2404
msgid "This pairing code has already been used by another site. Issue a new one from the dashboard."
msgstr "Цей код з’єднання вже використав інший сайт. Згенеруйте новий на панелі керування."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2484
msgid "This site has no public domain to register. A license can only be activated on a publicly reachable site."
msgstr "У цього сайту немає публічного домену для реєстрації. Ліцензію можна активувати лише на загальнодоступному сайті."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2964
msgid "This site is already registered. Regenerate the key with an administrator token if the existing key is unavailable."
msgstr "Цей сайт уже зареєстровано. Якщо наявний ключ недоступний, перегенеруйте його за допомогою токена адміністратора."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2096
msgid "To publish the FAQ, place the %1$s block or the %2$s shortcode on the page where it should appear. The questions are shown there and published as FAQPage structured data on that page only; search engines accept FAQ markup only for questions visitors can read."
msgstr "Щоб опублікувати FAQ, розмістіть блок %1$s або шорткод %2$s на сторінці, де він має відображатися. Запитання показуються там і публікуються як структуровані дані FAQPage лише на цій сторінці; пошукові системи приймають розмітку FAQ лише для запитань, які можуть прочитати відвідувачі."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2487
msgid "Too many activation attempts. Please wait and try again."
msgstr "Забагато спроб активації. Зачекайте та спробуйте ще раз."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2410
msgid "Too many attempts. Please wait and try again."
msgstr "Забагато спроб. Зачекайте та спробуйте ще раз."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:4046
msgid "Trend"
msgstr "Динаміка"

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:4453
msgid "Try again"
msgstr "Спробувати ще раз"

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:5683
msgid "Turn on /llms.txt"
msgstr "Увімкнути /llms.txt"

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3459
msgid "Turn on in settings"
msgstr "Увімкнути в налаштуваннях"

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:5682
msgid "Turn on structured data output"
msgstr "Увімкнути виведення структурованих даних"

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:1646
msgid "Turns on server-side output of the information AI reads."
msgstr "Вмикає серверний вивід інформації, яку читає ШІ."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:1697
msgid "URL"
msgstr "URL"

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2182
msgid "Used only when issuing a site key from the Nurevo service."
msgstr "Використовується лише під час генерування ключа сайту через сервіс Nurevo."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:1556
msgid "Valid JSON-LD with the right type and the key properties filled in."
msgstr "Коректний JSON-LD із правильним типом і заповненими ключовими властивостями."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:1712
msgid "Values are inferred from existing local SEO settings, WordPress settings, and clearly labelled public content. Automatic extraction is an estimate; verify before relying on it. Existing Nurevo values are never overwritten."
msgstr "Значення визначаються за наявними налаштуваннями локального SEO, налаштуваннями WordPress і чітко позначеним публічним вмістом. Автоматичне видобування — це оцінка; перевірте результат, перш ніж на нього покладатися. Уже введені значення Nurevo ніколи не перезаписуються."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3493
msgid "View the updated diagnosis"
msgstr "Переглянути оновлену діагностику"

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:4309
msgid "View this site on the nurevo.jp dashboard"
msgstr "Переглянути цей сайт на панелі керування nurevo.jp"

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:4033
msgid "vs previous"
msgstr "порівняно з минулим"

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3935
msgid "Waiting for the first measurement. This runs automatically once a week."
msgstr "Очікування першого вимірювання. Воно виконується автоматично раз на тиждень."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:4002
msgid "We put representative questions to the AI engines and measure how often your business is mentioned or cited in the answers, how that compares with competitors, and how it moves over time."
msgstr "Ми ставимо ШІ-системам типові запитання й вимірюємо, як часто ваш бізнес згадується або цитується у відповідях, як це співвідноситься з конкурентами та як змінюється з часом."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:4274
msgid "What AI cannot read from this site: %s"
msgstr "Що ШІ не може прочитати на цьому сайті: %s"

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:4402
msgid "Which plugin outputs each schema type"
msgstr "Який плагін виводить кожен тип schema"

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3165
msgid "WordPress could not resolve the WebMCP host name. Check the tag.js URL and DNS/network settings."
msgstr "WordPress не вдалося визначити ім’я хоста WebMCP. Перевірте URL tag.js і налаштування DNS/мережі."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3168
msgid "WordPress could not verify the WebMCP HTTPS certificate. Check the public Worker URL and server certificate."
msgstr "WordPress не вдалося перевірити HTTPS-сертифікат WebMCP. Перевірте публічну URL-адресу Worker і сертифікат сервера."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:4596
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:4597
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:4617
msgid "yes"
msgstr "так"

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2141
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2953
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3002
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3024
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:5698
msgid "You do not have permission to perform this action."
msgstr "У вас немає прав на виконання цієї дії."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:1544
msgid "Your CDN or WAF is letting AI bots through."
msgstr "Ваш CDN або WAF пропускає ШІ-ботів."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:1550
msgid "Your content and schema are in the raw HTML."
msgstr "Вміст і schema є у вихідному HTML."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:4013
msgid "Your free diagnosis, basic schema, llms.txt and AI crawler access carry on exactly as before."
msgstr "Безкоштовна діагностика, базова schema, llms.txt і доступ ШІ-краулерів працюють так само, як і раніше."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:1557
msgid "Your JSON-LD is missing some of the properties AI looks for."
msgstr "У вашому JSON-LD бракує деяких властивостей, які шукає ШІ."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:1569
msgid "Your key facts are hard to find in the page text."
msgstr "Ключові факти важко знайти в тексті сторінки."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:1568
msgid "Your key facts, headings and FAQ are readable in the page text."
msgstr "Ключові факти, заголовки та FAQ читаються в тексті сторінки."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:4005
msgid "Your Pro plan is active. Measurement needs a site key and site ID to be configured."
msgstr "Тариф Pro активний. Для вимірювання потрібно налаштувати ключ сайту та ID сайту."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:1580
msgid "Your schema agrees with your page text and carries a freshness signal."
msgstr "Schema узгоджується з текстом сторінки й містить ознаку актуальності."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:1581
msgid "Your schema and page text disagree in places, or the freshness signal is missing."
msgstr "Подекуди schema розходиться з текстом сторінки, або бракує ознаки актуальності."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:1582
msgid "Your schema contradicts your page text, which makes AI distrust both."
msgstr "Schema суперечить тексту сторінки, через що ШІ не довіряє ні тому, ні іншому."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3488
msgid "Your site now follows central ruleset v%2$d (was v%1$d). The diagnosis was re-run against the new criteria."
msgstr "Тепер сайт використовує центральний набір правил v%2$d (було v%1$d). Діагностику повторно виконано за новими критеріями."
