msgstr "Сервіс Nurevo не відповів протягом %d с. Можливо, вашому серверу заборонено вихідні з’єднання або сервіс перевантажений. Повторіть спробу пізніше."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2829
msgid "The Nurevo service is not configured."
msgstr "Сервіс Nurevo не налаштовано."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3486
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3754
msgid "The Nurevo service returned an error: %s"
msgstr "Сервіс Nurevo повернув помилку: %s"

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3479
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3666
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3670
