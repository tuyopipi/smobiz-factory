#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:5945
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:5965
msgid "The file is not a valid Nurevo AEO settings file."
msgstr "Файл не є коректним файлом налаштувань Nurevo AEO."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:5937
msgid "The file is not valid JSON."
msgstr "Файл не є коректним JSON."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:5460
msgid "The free AI check could not be run. Please try again later."
msgstr "Не вдалося виконати перевірку. Спробуйте пізніше."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:5082
