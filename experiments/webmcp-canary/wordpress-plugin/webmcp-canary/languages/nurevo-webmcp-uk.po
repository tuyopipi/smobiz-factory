msgstr "Сервер ліцензій не налаштовано."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:1995
msgid "The major AI crawlers are allowed in robots.txt."
msgstr "Основні ШІ-краулери дозволені в robots.txt."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2887
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2895
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:4471
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:4629
