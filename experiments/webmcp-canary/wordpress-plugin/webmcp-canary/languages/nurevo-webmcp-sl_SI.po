msgstr "Vašemu JSON-LD manjkajo nekatere lastnosti, ki jih išče AI."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:1475
msgid "Your key facts are hard to find in the page text."
msgstr "Ključna dejstva je v besedilu strani težko najti."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:1474
msgid "Your key facts, headings and FAQ are readable in the page text."
msgstr "Ključna dejstva, naslovi in pogosta vprašanja so v besedilu strani berljivi."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3812
