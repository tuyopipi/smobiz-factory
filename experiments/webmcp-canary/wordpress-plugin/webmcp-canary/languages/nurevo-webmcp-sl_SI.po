#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3448
msgid "The WebMCP server response did not match the expected format."
msgstr "Odziv strežnika WebMCP ni v pričakovani obliki."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3264
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3532
msgid "The WebMCP server returned an error: %s"
msgstr "Strežnik WebMCP je vrnil napako: %s"

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3257
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3444
