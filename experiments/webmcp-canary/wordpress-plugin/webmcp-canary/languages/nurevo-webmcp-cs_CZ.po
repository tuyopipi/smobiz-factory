msgstr "ano"

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2144
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2956
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3006
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3028
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:3297
#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:5820
