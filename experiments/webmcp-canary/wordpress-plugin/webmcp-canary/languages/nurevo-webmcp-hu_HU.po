msgid "Used only when issuing a site key from the Nurevo service."
msgstr "Csak akkor használatos, amikor webhelykulcsot adsz ki a Nurevo szolgáltatásból."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:1949
