msgstr "Slår JSON-LD-strukturerede data, /llms.txt og adgang for AI-søgecrawlere i robots.txt til."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2045
msgid "Turns on server-side output of the information AI reads."
msgstr "Slår serverside-output til for de oplysninger, som AI læser."

#: wordpress-plugin/webmcp-canary/nurevo-webmcp.php:2096
msgid "URL"
msgstr "URL"

